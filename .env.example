OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_DRIVE_FOLDER_ID=
VECTOR_STORE_ID=
# Opcional: define una clave para permitir sincronizar por API local (X-Admin-Key).
LOCAL_ADMIN_KEY=
PORT=5000

# --- Opciones de despliegue (Vercel / serverless) ---
# Directorio de datos. En Vercel el proyecto es de solo lectura: usa /tmp
# (efímero) o deja vacío para que se detecte automáticamente.
DATA_DIR=
# Credenciales de Google sin navegador (JSON en una sola línea).
# Cuenta de servicio (recomendado): comparte la carpeta de Drive con su email.
GOOGLE_SERVICE_ACCOUNT_JSON=
# O bien un token de usuario ya autorizado en local (incluye refresh_token).
GOOGLE_TOKEN_JSON=
